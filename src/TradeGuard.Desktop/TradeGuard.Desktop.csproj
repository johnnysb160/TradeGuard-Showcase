<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Só para o ícone de bandeja/notificações. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TradeGuard.Desktop</RootNamespace>
    <AssemblyName>TradeGuard</AssemblyName>
    <ApplicationIcon>tradeguard.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TradeGuard.UI\TradeGuard.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="tradeguard.ico" />
    <Content Include="tradeguard.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- WinForms e WPF têm nomes iguais (Application, MessageBox...): WinForms só com prefixo. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
