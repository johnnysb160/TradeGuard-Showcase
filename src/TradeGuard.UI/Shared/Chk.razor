<div class="form-check mb-2">
    <input class="form-check-input" type="checkbox" id="@_id" checked="@Value" disabled="@Disabled"
           @onchange="e => ValueChanged.InvokeAsync(e.Value is true)" />
    <label class="form-check-label small" for="@_id" title="@Hint">@Label@(Hint is null ? "" : " ⓘ")</label>
</div>

@code {
    private readonly string _id = "chk" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
}
